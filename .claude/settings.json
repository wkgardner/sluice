{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_production_and_secrets.py\"",
            "timeout": 15,
            "statusMessage": "Checking production + secret guardrails"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/arch_guard.py\"",
            "timeout": 180,
            "statusMessage": "Checking gates -> core dependency arrow"
          }
        ]
      }
    ]
  }
}
